      <a name="font" val="SansSerif bold 12"/>
    </comp>
    <comp lib="0" loc="(480,130)" name="Probe">
      <a name="facing" val="south"/>
      <a name="label" val="加扰后"/>
      <a name="labelfont" val="Dialog plain 12"/>
