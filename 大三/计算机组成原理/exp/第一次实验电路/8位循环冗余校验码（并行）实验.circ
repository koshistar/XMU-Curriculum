    </comp>
    <comp lib="6" loc="(223,432)" name="Text">
      <a name="text" val="1、无错：无错灯红色，数据正确灯红色，接收数据等于发送数据"/>
      <a name="font" val="SansSerif bold 12"/>
    </comp>
