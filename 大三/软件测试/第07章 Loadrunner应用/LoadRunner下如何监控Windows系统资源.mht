    var userName =3D getCookie("UserName");
    var isGuest =3D !userName || userName =3D=3D "Guest";
    var delay =3D 20 * 60 * 1000;
    var timer =3D 0;

    function ChangeUserState() {       =20
        clearInterval(timer);
        if (isGuest) {
            HideNoticeInfo();
        }
        else {
            RefreshNoticeInfo();
            timer =3D setInterval( RefreshNoticeInfo, delay);
        }
    }
   =20
    var apiUrl =3D "/!handler/NoticeHandler.ashx?jsoncallback=3D?";
    function RefreshNoticeInfo() {
        $.getJSON(apiUrl + "&_t=3D" + Math.random(), function(result) {
            if (result.noticeNum) {
                newNoticeCount =3D result.noticeNum;
                if (newNoticeCount <=3D 0) {
                    $("#notice").hide();
                }
                else {
                    $("#noticeCount").text(newNoticeCount);
                    $("#notice").show();
                }
            }
        });
    }
   =20
    function HideNoticeInfo() {
        $("#notice").hide();
    }
</SCRIPT>

