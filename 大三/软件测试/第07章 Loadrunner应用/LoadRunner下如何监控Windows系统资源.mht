				function absolutePoint(element) {
					var result =3D { x: element.offsetLeft, y: element.offsetTop };
					element =3D element.offsetParent;
					while (element) {
						result.x +=3D element.offsetLeft;
						result.y +=3D element.offsetTop;
						element =3D element.offsetParent;
					}
