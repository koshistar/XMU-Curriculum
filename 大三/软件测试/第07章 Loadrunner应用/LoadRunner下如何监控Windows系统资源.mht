				function startmarquee(lh, speed, delay, index) {
					var t;
					var p =3D false;
					var o =3D document.getElementById("marqueebox" + index);
					o.innerHTML +=3D o.innerHTML;
					o.onmouseover =3D function () { p =3D true }
					o.onmouseout =3D function () { p =3D false }
					o.scrollTop =3D 0;
					function start() {
						t =3D setInterval(scrolling, speed);
						if (!p) o.scrollTop +=3D 2;
					}
					function scrolling() {
						if (o.scrollTop % lh !=3D 0) {
							o.scrollTop +=3D 2;
							if (o.scrollTop >=3D o.scrollHeight / 2) o.scrollTop =3D 0;
						} else {
							clearInterval(t);
							setTimeout(start, delay);
						}
					}
					setTimeout(start, delay);
				}

				function addEventHandler(target, type, func) {
					if (target.addEventListener)
						target.addEventListener(type, func, false);
					else if (target.attachEvent)
						target.attachEvent("on" + type, func);
					else target["on" + type] =3D func;
				}

