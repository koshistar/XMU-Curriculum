var cookie =3D {
	//=C9=E8=D6=C3cookie
	set: function (name, value, time, path, domain)=20
	{
		var expires =3D "";
		if (time)=20
		{
			var date =3D new Date();
			date.setTime(date.getTime() + time * 1000);
			expires =3D "; expires=3D" + date.toGMTString();
		}
		if (!path) path =3D "/";
	=09
		if (domain)
		{
			document.cookie =3D name + "=3D" + value + expires + "; path=3D" + =
path + "; domain=3D" + domain + ";";
		}
		else
		{
			document.cookie =3D name + "=3D" + value + expires + "; path=3D" + =
path + ";";
		}
	},

	//=C8=A1=B5=C3cookie=D6=B5
	get: function (name)=20
	{
		var name =3D name + "=3D";
		var cookies =3D document.cookie.split(";");

		for(var i=3D0; i<cookies.length; i++)=20
		{
			var c =3D cookies[i];
			while (c.charAt(0) =3D=3D " ") c =3D c.substring(1, c.length);
			if (c.indexOf(name) =3D=3D 0) return c.substring(name.length, =
c.length);
		}
		return null;
	}
}

